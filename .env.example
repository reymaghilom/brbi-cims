APP_NAME="BRBI CIMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC
CIMS_DISPLAY_TIMEZONE=Asia/Manila
CIMS_SEED_DEMO_DATA=false
# Optional directory that directly contains Client folders (for example, D:\CI Team; omit \Clients).
CIMS_DOCUMENTS_ROOT=
# Factories only persist automatically during PHPUnit (testing). Set this to true only when you
# intentionally want Model::factory()->create() to write to this environment's own database.
ALLOW_FACTORY_WRITES=false

# Residence Check "Verified Map Location" — Maps JavaScript API + Places API (New).
# Restrict this key (HTTP referrers) in Google Cloud Console before use in production.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Telegram Bot API delivery for saved Residence/Business Documentation.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cloudinary — permanent storage for new Residence/Business photos and map screenshots.
# Set either CLOUDINARY_URL (the single connection string from the Cloudinary dashboard)
# or the three CLOUDINARY_CLOUD_NAME / CLOUDINARY_API_KEY / CLOUDINARY_API_SECRET values
# below. Leave all of these blank to keep using local/private storage for new uploads.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=BRBI-CIMS

# n8n CI Activity email reminders (disabled by default). The webhook URL must be https:// and the
# signing secret a dedicated random value of at least 32 characters, shared only with that n8n
# webhook. Delivery runs via `php artisan n8n-reminders:deliver`.
N8N_REMINDERS_ENABLED=false
N8N_REMINDERS_WEBHOOK_URL=
N8N_REMINDERS_SIGNING_SECRET=
N8N_REMINDERS_DISPATCH_AFTER_COMMIT=false

# n8n -> Laravel one-time reminder authorization (Phase 2A-5; disabled by default).
# NOT USED by the selected Phase 2A-6 one-way architecture: leave it false.
# Store the same dedicated random 32+ character value in an n8n Header Auth credential, never in
# workflow JSON. Do not enable until the hosting/reachability and staging gates are approved.
N8N_REMINDER_AUTHORIZATION_ENABLED=false
N8N_REMINDER_AUTHORIZATION_TOKEN=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=brbi_cims
DB_USERNAME=brbi_cims
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="cims@brbi.local"
MAIL_FROM_NAME="${APP_NAME}"

# Brevo HTTPS transactional API used only for Laravel forgot-password emails.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="${APP_NAME}"
BREVO_TIMEOUT_SECONDS=10

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
